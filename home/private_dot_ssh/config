Host *
  AddKeysToAgent yes
  UseKeychain yes            # macOS 专属：把口令存入钥匙串
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes         # 只用列出的密钥，避免“乱试所有密钥”
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
  # ExitOnForwardFailure yes

Host github.com
  HostName ssh.github.com
  Port 443
  User git

